# ── Server ───────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── API Security ─────────────────────────────────────
API_KEY=your_secret_api_key_here

# ── MongoDB ──────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/log_aggregator

# ── Redis ────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ── CORS ─────────────────────────────────────────────
CORS_ORIGIN=*
